PORT=4000
# Local BioTime: http://127.0.0.1:8000
# Cloud BioTime: https://your-company.itimedev.minervaiot.com
BIO_TIME_BASE_URL=http://127.0.0.1:8000
# Optional — only needed if your BioTime auth endpoint requires a company field
# BIO_TIME_COMPANY=your-company
# Local BioTime usually needs token auth. Use the same user name/password as http://127.0.0.1:8000
# Auth mode: token (recommended for local) or basic
BIO_TIME_AUTH_MODE=token
BIO_TIME_EMAIL=your-email@example.com
BIO_TIME_PASSWORD=your-password
#https://auinfocity.itimedev.minervaiot.com
